# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL + pgvector)
# For Docker: postgresql+asyncpg://postgres:password123@db:5432/lenny_assistant
# For Local fallback: sqlite+aiosqlite:///./lenny_assistant.db
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant

# LLM Providers Configuration
# Default provider: "ollama" (mandatory local demo) or "claude"
DEFAULT_PROVIDER=ollama

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60.0

# Cloud LLM Configuration (Anthropic Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# RAG & Retrieval Settings
SIMILARITY_THRESHOLD=0.55
TOP_K_RETRIEVAL=5
